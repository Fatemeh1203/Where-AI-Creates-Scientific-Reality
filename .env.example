# ── Site ──────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose (public).
NEXT_PUBLIC_SUPABASE_URL=https://dajxhpkklsfwqpdjsorw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRhanhocGtrbHNmd3FwZGpzb3J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQzOTYzMDYsImV4cCI6MjA5OTk3MjMwNn0.BuD7gKHIgnhIwF2XoVrtBnvbfQeycnt7QSg_qrbgRjo
# SECRET — server-only. Get this from Supabase Dashboard → Project Settings → API → service_role key.
# Required for the /api/contact and /api/orders routes to write to the database (RLS blocks anon access).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications (Resend) ─────────────────────────────────────────
# Get a free API key at https://resend.com
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. "Simorgh AI Labs <hello@yourdomain.com>".
# Leave unset to use Resend's onboarding@resend.dev test sender (limited to your own Resend account email).
NOTIFICATIONS_FROM_EMAIL=Simorgh AI Labs <onboarding@resend.dev>
# Where contact/order notifications are sent.
NOTIFICATIONS_TO_EMAIL=f.shams.apg@gmail.com

# ── ZarinPal payment gateway ─────────────────────────────────────────────
# Defaults to ZarinPal's public sandbox merchant ID, so the deposit/checkout
# flow works out of the box in test mode without any account.
# For real payments: create a merchant at https://www.zarinpal.com, set your
# real Merchant ID below, and set ZARINPAL_SANDBOX=false.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# ── Private lab (gated current-sensor simulator at /lab) ─────────────────
# Password visitors must enter to view the private simulator. Default is
# "project01" if unset. Change it here to rotate the access code.
LAB_PASSWORD=project01
# Secret used to sign the lab auth cookie. Set to any long random string in
# production so auth cookies can't be forged.
LAB_COOKIE_SECRET=change-me-to-a-long-random-string
